#version 450
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#define MAX_WAVELENGTHS 32
#define MAX_SOURCES 64
#define PI 3.14159265359

struct WaveComponent {
    float wavelength_nm;
    float amplitude;
    float phase;
    vec3 polarization;
};

struct WaveSpectrum {
    WaveComponent components[MAX_WAVELENGTHS];
    uint count;
};

struct LightSource {
    vec3 position;
    vec3 direction;
    WaveSpectrum spectrum;
    float intensity;
    float coherence_length;
    float coherence_time;
    bool is_coherent;
    int quantum_state;
};

struct QuantumCoherenceParams {
    ivec2 resolution;
    uint num_sources;
    float time;
    float detector_separation;
    int experiment_type;
    float bunching_parameter;
};

layout(set = 0, binding = 0, std140) uniform Params {
    QuantumCoherenceParams params;
};

layout(set = 0, binding = 1, std140) readonly buffer SourceBuffer {
    LightSource sources[MAX_SOURCES];
};

layout(set = 0, binding = 2, std140) writeonly buffer OutputBuffer {
    vec4 output_image[];
};

float g2_coherent(float tau, float coherence_time) {
    return 1.0 + exp(-abs(tau) / coherence_time);
}

float g2_thermal(float tau, float coherence_time) {
    return 2.0 - exp(-abs(tau) / coherence_time);
}

float g2_fock(float tau, float coherence_time, int n) {
    if (n == 0) return 0.0;
    if (n == 1) return 0.0;
    return 1.0 - 1.0/float(n);
}

float hong_ou_mandel_dip(float delay, float coherence_time) {
    float visibility = 1.0;
    float width = coherence_time;
    return 1.0 - visibility * exp(-(delay*delay) / (width*width));
}

float photon_bunching(int n_photons, float tau, float tau_c) {
    if (n_photons <= 1) return 1.0;
    float g2 = g2_thermal(tau, tau_c);
    return 1.0 + (g2 - 1.0) / float(n_photons);
}

float spectral_degree_coherence(float tau, float bandwidth) {
    return exp(-PI * bandwidth * bandwidth * tau * tau / (4.0 * log(2.0)));
}

vec3 wavelength_to_rgb(float lambda) {
    vec3 rgb = vec3(0.0);
    if (lambda >= 380.0 && lambda < 440.0) {
        rgb = vec3(-(lambda - 440.0) / 60.0, 0.0, 1.0);
    } else if (lambda >= 440.0 && lambda < 490.0) {
        rgb = vec3(0.0, (lambda - 440.0) / 50.0, 1.0);
    } else if (lambda >= 490.0 && lambda < 510.0) {
        rgb = vec3(0.0, 1.0, -(lambda - 510.0) / 20.0);
    } else if (lambda >= 510.0 && lambda < 580.0) {
        rgb = vec3((lambda - 510.0) / 70.0, 1.0, 0.0);
    } else if (lambda >= 580.0 && lambda < 645.0) {
        rgb = vec3(1.0, -(lambda - 645.0) / 65.0, 0.0);
    } else if (lambda >= 645.0 && lambda <= 780.0) {
        rgb = vec3(1.0, 0.0, 0.0);
    }
    
    float factor = 1.0;
    if (lambda < 420.0) factor = 0.3 + 0.7 * (lambda - 380.0) / 40.0;
    else if (lambda > 700.0) factor = 0.3 + 0.7 * (780.0 - lambda) / 80.0;
    
    return rgb * factor;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= params.resolution.x || pixel.y >= params.resolution.y) return;
    
    uint idx = pixel.y * params.resolution.x + pixel.x;
    
    vec2 uv = (vec2(pixel) + 0.5) / vec2(params.resolution);
    uv = uv * 2.0 - 1.0;
    
    float intensity = 0.0;
    vec3 color = vec3(0.0);
    
    if (params.experiment_type == 0) {
        float delay = uv.x * params.detector_separation * 1e-12;
        float g2 = hong_ou_mandel_dip(delay, sources[0].coherence_time * 1e-15);
        intensity = g2;
        color = vec3(intensity);
    }
    else if (params.experiment_type == 1) {
        float tau = uv.x * 10e-12;
        int n = int(sources[0].quantum_state);
        float g2 = photon_bunching(n, tau, sources[0].coherence_time * 1e-15);
        intensity = g2;
        color = vec3(intensity);
    }
    else if (params.experiment_type == 2) {
        float tau = uv.x * 10e-12;
        float bandwidth = 1.0 / sources[0].coherence_time;
        float g1 = spectral_degree_coherence(tau, bandwidth);
        intensity = g1 * g1;
        color = vec3(intensity);
    }
    else if (params.experiment_type == 3) {
        float tau = uv.x * 5e-12;
        float tau_c = sources[0].coherence_time * 1e-15;
        float g2_coh = g2_coherent(tau, tau_c);
        float g2_therm = g2_thermal(tau, tau_c);
        float mix = 0.5 + 0.5 * sin(uv.y * 10.0);
        float g2 = mix * g2_coh + (1.0 - mix) * g2_therm;
        intensity = g2;
        color = vec3(g2_coh, g2, g2_therm);
    }
    else if (params.experiment_type == 4) {
        float tau = uv.x * 10e-12;
        float tau_c = sources[0].coherence_time * 1e-15;
        int n = max(1, int(sources[0].quantum_state));
        float g2 = g2_fock(tau, tau_c, n);
        intensity = g2;
        color = vec3(intensity);
    }
    
    for (uint s = 0; s < params.num_sources; s++) {
        LightSource src = sources[s];
        for (uint w = 0; w < src.spectrum.count; w++) {
            WaveComponent comp = src.spectrum.components[w];
            color = wavelength_to_rgb(comp.wavelength_nm) * color;
        }
    }
    
    color = pow(clamp(color, 0.0, 1.0), vec3(1.0 / 2.2));
    output_image[idx] = vec4(color, 1.0);
}